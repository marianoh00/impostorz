<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Window background to match the game's deep-slate canvas to avoid white flash -->
        <item name="android:windowBackground">@drawable/bg_deep_slate</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Use a layered drawable that applies the game's background color behind the splash foreground -->
        <item name="android:background">@drawable/splash_bg</item>
        <!-- Ensure Android 12+ splashscreen APIs use the same drawable and icon -->
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="windowSplashScreenBackground">@drawable/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <!-- After the splash, use the app theme (which sets windowBackground) so no white flash appears -->
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>